# Apache Hive Configuration
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_SERVER2_HTTP_PORT=10002
HIVE_DATABASE=news_risk
HIVE_DOCKER_CONTAINER=hive4
HIVE_USER=anonymous
HIVE_PASSWORD=anonymous

# Risk Scoring Configuration Weights & Thresholds
RISK_NEGATIVE_WEIGHT=0.60
RISK_SEVERITY_WEIGHT=0.40
RISK_LOW_THRESHOLD=40.0
RISK_HIGH_THRESHOLD=75.0

# Data paths
RAW_DATA_PATH=data/raw/news.csv
PROCESSED_DATA_PATH=data/processed/news_enriched.tsv
OUTPUTS_DIR=outputs
